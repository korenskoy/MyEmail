//
//  Secrets.swift.template
//  MyEmail
//
//  ⚠️ TEMPLATE FILE. Скопируй в `Secrets.swift` (в той же папке App/), замени
//  placeholder'ы на реальные значения. `Secrets.swift` gitignored.
//
//      cp MyEmail/App/Secrets.swift.template MyEmail/App/Secrets.swift
//
//  `Secrets.swift` потом нужно **добавить в Xcode target вручную** (Add Files
//  to "MyEmail"… → без Copy items).
//
//  ── Google OAuth2 ──────────────────────────────────────────────────────────
//
//  Как получить credentials:
//  1. https://console.cloud.google.com/apis/credentials
//  2. Create Credentials → OAuth client ID
//  3. Application type: **iOS** (подходит и для macOS — Google выдаёт
//     reverse-domain redirect URI, который ловится через custom URL scheme).
//     НЕ выбирай **Desktop app** — он рассчитан на loopback-redirect и
//     требует NWListener + network.server entitlement.
//  4. Bundle ID: `ru.korenskoy.MyEmail` (или любой свой, главное совпадение
//     с `PRODUCT_BUNDLE_IDENTIFIER` в Xcode target)
//  5. После Create Google показывает:
//       - Client ID
//       - iOS URL scheme — формат `com.googleusercontent.apps.{CLIENT_ID_PREFIX}`
//     Client secret для iOS type **не выдаётся** — и не нужен (PKCE это и
//     гарантирует: secret в desktop app non-confidential по определению).
//     Для Gmail XOAUTH2 Google всё равно принимает `client_secret=""`
//     в token exchange, но современный API игнорирует пустое значение.
//
//  Scope (registered в OAuth consent screen, не здесь):
//  - `https://mail.google.com/`  (IMAP + SMTP XOAUTH2)
//  - `email`  (чтобы получить адрес через userinfo endpoint)
//  - Contacts scope **не запрашиваем никогда** — `ContactsService` работает
//    только с локальным `CNContactStore`.
//
//  PKCE (RFC 8252):
//  - PKCE обязателен. `code_challenge` (SHA-256 от `code_verifier`) в auth
//    request, `code_verifier` в token exchange. См. `Utilities/PKCE.swift`.
//
//  Redirect URI:
//  - `com.googleusercontent.apps.{CLIENT_ID_PREFIX}:/oauthredirect`
//  - Google выдаёт это значение автоматически при создании iOS client.
//  - Scheme часть (до `:`) регистрируется в Info.plist как `CFBundleURLTypes`
//    — см. M2-account-setup.md.
//
//  ── Commit check ───────────────────────────────────────────────────────────
//
//  `Secrets.swift` уже в `.gitignore`. Не убирай оттуда. Если случайно
//  коммитнул client secret — немедленно rotate в Google Cloud Console и
//  удали коммит из истории через `git filter-repo` (не `git rm`).
//

import Foundation

enum Secrets {

    // MARK: - Google OAuth2

    static let googleClientID = "REPLACE_ME.apps.googleusercontent.com"

    /// Для iOS OAuth client type Google не выдаёт secret — оставь пустую
    /// строку. Для Desktop/Web client type впиши реальное значение.
    static let googleClientSecret = ""

    /// Reverse-domain redirect URI от Google — формат
    /// `com.googleusercontent.apps.{CLIENT_ID_PREFIX}:/oauthredirect`.
    static let googleRedirectURI = "com.googleusercontent.apps.REPLACE_ME:/oauthredirect"

    /// Часть до `:` — регистрируется в Info.plist как URL scheme.
    static let googleRedirectScheme = "com.googleusercontent.apps.REPLACE_ME"
}
